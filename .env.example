# Copy to .env (gitignored) and fill in. Everything is optional — each
# integration is a no-op until its keys are set.

# --- Context engine (cloud role) ---
OPENAI_API_KEY=            # gpt-4o-mini situation composer; unset => rules composer
GOOGLE_MAPS_API_KEY=       # Places/roads context; unset => OpenStreetMap fallback
# CTX_OPENAI_DAILY_CAP=200 # spend guard: max LLM calls/day (see context_engine/composer.py)

# --- Demo hub ---
# ACCESS_CODE is gone: the demo is public and throttled instead (per-IP
# limits + one model slot, see demo/app.py). Old ?k=... links still open.
ORIN_URL=http://192.168.55.1:8080     # llama-server on the board
ORIN_SSH=user@192.168.55.1            # board ssh target (key-based auth assumed)
CTX_ENGINE_URL=http://localhost:8090
# TELEMETRY_LOCAL=1        # set when the hub runs ON the board (no ssh in tester path)

