[Unit]
Description=Veris llama-server (VLM backend, :8080)
After=local-fs.target

[Service]
User=@VERIS_USER@
Group=@VERIS_USER@
Environment=HOME=/home/@VERIS_USER@
EnvironmentFile=-/home/@VERIS_USER@/veris-app/.env
# Page cache must be dropped (as root) before every start or large GPU
# allocations fail on the 8GB board.
ExecStartPre=+/bin/sh -c 'sync; echo 3 > /proc/sys/vm/drop_caches'
# sh wrapper because systemd does not expand ${VAR:-default}.
ExecStart=/bin/sh -c 'exec /home/@VERIS_USER@/llama.cpp/build/bin/llama-server \
  -m "${VERIS_MODEL:-/home/@VERIS_USER@/models/qwen2.5-vl-3b/Veris-3B-v1-Q4_K_M.gguf}" \
  --mmproj /home/@VERIS_USER@/models/qwen2.5-vl-3b/mmproj-Qwen2.5-VL-3B-Instruct-Q8_0.gguf \
  --no-mmap -ngl 99 --host 0.0.0.0 --port 8080 -c 4096 -np 1 ${VERIS_LLM_EXTRA:-}'
# This build (b9870) segfaults if the first request it processes carries an
# image; one text completion first makes images work. The hub also warms each
# new instance before its first frame (demo/app.py), this covers callers that
# bypass the hub, e.g. bench scripts on the board. Model load takes ~40 s.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 180); do curl -sf -m 2 localhost:8080/health >/dev/null && break; sleep 1; done; \
  curl -s -m 60 localhost:8080/v1/chat/completions -H "Content-Type: application/json" \
  -d "{\"messages\":[{\"role\":\"user\",\"content\":\"Say ready.\"}],\"max_tokens\":4}" >/dev/null || true'
Restart=always
RestartSec=15
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
